{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Ingestor": {
    "Pipeline": {
      "ChannelCapacity": 100000,
      "BatchSize": 1000,
      "FlushInterval": "00:00:00.250",
      "ConsumerCount": 2,
      "EnqueueTimeout": "00:00:00.050",
      "MaxFlushRetries": 3,
      "RetryBaseDelay": "00:00:00.100",
      "DrainTimeout": "00:00:10",
      "MaxPayloadBytes": 262144,
      "MaxLineBytes": 524288
    }
  }
}
