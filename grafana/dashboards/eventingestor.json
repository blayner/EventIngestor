          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(ingestor_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99 {{endpoint}}"
        }
